# Optional overrides for QueueVision defaults. Command-line arguments win.
# The app reads real environment variables; .env is not auto-loaded.
# To use this file:  cp .env.example .env && set -a && source .env && set +a
QUEUEVISION_MODEL=ai_engine/models/yolo11n.pt
QUEUEVISION_DEVICE=auto
QUEUEVISION_CONFIDENCE=0.35
QUEUEVISION_IMGSZ=640
