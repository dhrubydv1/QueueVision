# Local Python environment
venv/
.venv/

# Python cache and tooling files
__pycache__/
*.py[cod]
.pytest_cache/

# Environment files (keep the example)
.env
.env.*
!.env.example

# YOLO model weights and exported models
*.pt
*.pth
*.onnx
*.engine
*.mlpackage/

# Datasets: keep folder structure and README only
datasets/raw/*
datasets/processed/*
datasets/videos/*
datasets/frames/*
datasets/annotations/**
!datasets/annotations/**/
!datasets/*/.gitkeep
!datasets/annotations/**/.gitkeep
# datasets/metadata/ and datasets/splits/ are tracked (no ignore rules)

# Generated results: keep folder structure only
outputs/**
!outputs/
!outputs/.gitkeep
!outputs/*/
!outputs/*/.gitkeep

# macOS
.DS_Store
._*

# Local agent workspace
.superpowers/

# Local API data (uploads, outputs, SQLite)
/data/
